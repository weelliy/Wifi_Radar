<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Координаты: ожидание GPS..."
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:paddingBottom="4dp"/>

    <com.example.wifiradar.RadarView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvAltitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Высота: ожидание GPS..."
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        
        <EditText
            android:id="@+id/etFloor"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Этаж"
            android:inputType="numberSigned"
            android:padding="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- НОВОЕ: Поле ввода описания -->
        <EditText
            android:id="@+id/etDescription"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:hint="Описание (напр. корпус 3, каб. 211)"
            android:inputType="text"
            android:padding="8dp"
            android:layout_marginBottom="4dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <TextView
            android:id="@+id/tvNetworks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <Button
        android:id="@+id/btnMarkPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Зафиксировать точку (Сохранить)"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Сканировать" />
        <Button android:id="@+id/btnExportCsv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="CSV" />
        <Button android:id="@+id/btnExportKml" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="KML" />
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Очистить" />
    </LinearLayout>
</LinearLayout>
