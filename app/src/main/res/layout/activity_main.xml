<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#050B14">

    <TextView android:id="@+id/tvLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Координаты: ..." android:textColor="#00E5FF" android:fontFamily="monospace" />
    <TextView android:id="@+id/tvAccuracy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Точность: ..." android:textColor="#39FF14" android:fontFamily="monospace" />
    <TextView android:id="@+id/tvPointsCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Точек: 0" android:textColor="#FFD700" android:fontFamily="monospace" />

    <!-- Радар -->
    <com.example.wifiradar.RadarView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView android:id="@+id/tvAltitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Высота: ..." android:textColor="#FFFFFF" android:fontFamily="monospace" />

    <!-- Настройки -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Spinner android:id="@+id/spinnerEnvironment" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:entries="@array/environments" />
        <RadioGroup android:id="@+id/rgFrequency" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Все" android:textColor="#FFF" android:checked="true"/>
            <RadioButton android:id="@+id/rb5G" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5G" android:textColor="#FFF"/>
        </RadioGroup>
    </LinearLayout>

    <EditText android:id="@+id/etFloor" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Этаж" android:inputType="numberSigned" android:textColor="#FFF" />
    <EditText android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Описание" android:textColor="#FFF" />

    <ScrollView android:layout_width="match_parent" android:layout_height="80dp">
        <TextView android:id="@+id/tvNetworks" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B0BEC5" android:textSize="11sp" android:fontFamily="monospace"/>
    </ScrollView>

    <!-- Кнопки -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnMarkPoint" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="📍 Фикс" android:backgroundTint="#FF9800" android:textColor="#FFF"/>
        <Button android:id="@+id/btnAutoRecord" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="⏺ Авто" android:backgroundTint="#2196F3" android:textColor="#FFF"/>
        <Button android:id="@+id/btnHistory" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📜 Ист" android:backgroundTint="#9C27B0" android:textColor="#FFF"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Скан" />
        <Button android:id="@+id/btnShareCsv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Share CSV" android:backgroundTint="#4CAF50"/>
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Очист" android:backgroundTint="#F44336"/>
    </LinearLayout>
</LinearLayout>
