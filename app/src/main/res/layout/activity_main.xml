<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Блок с координатами и точностью -->
    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Координаты: ожидание GPS..."
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:paddingBottom="2dp"/>

    <TextView
        android:id="@+id/tvAccuracy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Точность: н/д"
        android:textSize="14sp"
        android:textColor="#4CAF50"
        android:fontFamily="monospace"
        android:paddingBottom="8dp"/>

    <!-- Радар -->
    <com.example.wifiradar.RadarView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvAltitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Высота: ожидание GPS..."
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="4dp" />

    <!-- Поля ввода -->
    <EditText
        android:id="@+id/etFloor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Введите этаж (например, 5 или -1)"
        android:inputType="numberSigned"
        android:padding="8dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Описание (напр. корпус 3, кабинет 211)"
        android:inputType="text"
        android:padding="8dp"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/tvNetworks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Кнопки фиксации и автозаписи -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        
        <Button
            android:id="@+id/btnMarkPoint"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="📍 Зафиксировать"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAutoRecord"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="⏺ Авто"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Нижние кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Скан" />
        <Button android:id="@+id/btnExportCsv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="CSV" />
        <Button android:id="@+id/btnExportKml" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="KML" />
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Очистить" />
    </LinearLayout>
</LinearLayout>
